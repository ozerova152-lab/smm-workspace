{
  "name": "smm-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo --outDir dist-demo",
    "lint": "oxlint",
    "check": "npm run lint && npm run test:unit && npm run build",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mantine/core": "9.8.2",
    "@mantine/hooks": "9.8.2",
    "lucide-react": "1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
